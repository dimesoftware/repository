<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Label="Globals">
		<Nullable>annotations</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<IncludeSource>True</IncludeSource>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<AssemblyName>Dime.Repositories.Sql.EntityFramework</AssemblyName>
		<PackageId>Dime.Repositories.Sql.EntityFramework</PackageId>
		<PackageTags>Entity Framework;Repository;SQL</PackageTags>
		<Description>Implementation of the repository pattern with Microsoft SQL using Entity Framework Core</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Dime.Repositories.Sql.EntityFramework.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\core\Dime.Repositories.Sql\Dime.Repositories.Sql.csproj" />
		<ProjectReference Include="..\..\core\Dime.Repositories\Dime.Repositories.csproj" />
	</ItemGroup>

</Project>
